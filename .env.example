APP_NAME=content-service
APP_ENV=development
GRPC_PORT=50054
HTTP_PORT=50055

# Required when APP_ENV is not "development". Use a long random value.
JWT_SECRET=change-me

STORAGE_BASE_URL=http://localhost:50055/storage/uploads
STORAGE_UPLOAD_DIR=storage/uploads

DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/content_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30
MIGRATIONS_PATH=db/migrations
